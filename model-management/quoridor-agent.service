[Unit]
Description=Quoridor pinned-model agent service
After=network-online.target

[Service]
WorkingDirectory=/home/jihua/workspace/boardgame-ai-arena
Environment=QUORIDOR_AGENT_DEFS_DIR=/home/jihua/quoridor-data/agent_defs
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/home/jihua/workspace/boardgame-ai-arena/.venv/bin/python -m uvicorn agent_system.runtime.service.server:app --host 0.0.0.0 --port 8743
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
