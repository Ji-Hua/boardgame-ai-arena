# syntax=docker/dockerfile:1
ARG RUNTIME_IMAGE
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY training-dashboard/frontend/package.json training-dashboard/frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY training-dashboard/frontend ./
RUN npm run typecheck && npm run test:ui && npm run build

FROM ${RUNTIME_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
COPY training-dashboard/backend /app/training-dashboard/backend
COPY training-dashboard/platform_entry.py training-dashboard/platform_play.py /app/training-dashboard/
COPY --from=frontend /build/dist /app/training-dashboard/frontend/dist
ENV PLATFORM_FRONTEND_DIST=/app/training-dashboard/frontend/dist     TRAINING_DASHBOARD_SOURCE_ROOT=/app     PLATFORM_LAB_UPSTREAM=http://lab:8744
EXPOSE 8741
CMD ["python", "-m", "uvicorn", "platform_entry:create_app", "--factory", "--app-dir", "/app/training-dashboard", "--host", "0.0.0.0", "--port", "8741"]
