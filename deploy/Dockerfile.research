# syntax=docker/dockerfile:1
ARG RUNTIME_IMAGE=quoridor-migration-runtime:20261025
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/board-ui/package.json packages/board-ui/package.json
RUN npm ci --ignore-scripts
COPY apps/web apps/web
COPY packages/board-ui packages/board-ui
RUN npm run typecheck && npm run test:ui && npm run build

FROM ${RUNTIME_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
COPY scripts/start_unified_platform.sh /app/scripts/start_unified_platform.sh
COPY training-dashboard/backend /app/training-dashboard/backend
COPY training-dashboard/platform_entry.py /app/training-dashboard/
COPY apps/gameplay /app/apps/gameplay
COPY agent_system/games /app/agent_system/games
COPY agent_system/runtime/research_policy.py /app/agent_system/runtime/research_policy.py
COPY agent_system/evaluation/mrjack_policies.py /app/agent_system/evaluation/mrjack_policies.py
COPY --from=frontend /build/apps/web/dist /app/apps/web/dist
ENV PLATFORM_FRONTEND_DIST=/app/apps/web/dist     TRAINING_DASHBOARD_SOURCE_ROOT=/app     PLATFORM_LAB_UPSTREAM=http://lab:8744
EXPOSE 8741
CMD ["python", "-m", "uvicorn", "platform_entry:create_app", "--factory", "--app-dir", "/app/training-dashboard", "--host", "0.0.0.0", "--port", "8741"]
