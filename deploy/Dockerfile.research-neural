FROM python:3.12-slim
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/job/source
WORKDIR /job/source
COPY requirements-research.txt /tmp/requirements.txt
RUN pip install --no-cache-dir torch==2.11.0 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r /tmp/requirements.txt && pip freeze > /python-dependencies.txt
CMD ["python", "-m", "agent_system.training.jobs", "/job/job.json"]
