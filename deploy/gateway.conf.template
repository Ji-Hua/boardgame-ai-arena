server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;
    # Every deployment using this template must set PLATFORM_UPSTREAM, JOBS_UPSTREAM and GAMEPLAY_UPSTREAM.
    # Job controller (host process).
    location ^~ /api/v1/jobs {
        proxy_connect_timeout 5s;
        proxy_pass http://${JOBS_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
    # Gameplay service: the only owner of game state.
    location ^~ /api/v1/play {
        proxy_connect_timeout 5s;
        proxy_pass http://${GAMEPLAY_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_read_timeout 120s;
    }
    location ~ ^/(api/|research-lab(/|$)|health$) {
        proxy_connect_timeout 5s;
        proxy_pass http://${PLATFORM_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }
    location /assets/ { try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location ~ \.(json|js|css|png|svg)$ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
