server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;
    # Every deployment using this template must set PLATFORM_UPSTREAM, JOBS_UPSTREAM, GAMEPLAY_UPSTREAM and MLFLOW_UPSTREAM.
    # Job controller (host process).
    location ^~ /api/v1/jobs {
        proxy_connect_timeout 5s;
        proxy_pass http://${JOBS_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
    # Promotion decisions are written by the Job controller (the only writer of the data root).
    location ^~ /api/v1/promotions {
        proxy_connect_timeout 5s;
        proxy_pass http://${JOBS_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_read_timeout 60s;
    }
    # Gameplay service: the only owner of game state.
    location ^~ /api/v1/play {
        proxy_connect_timeout 5s;
        proxy_pass http://${GAMEPLAY_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_read_timeout 120s;
    }
    location ~ ^/(api/|research-lab(/|$)|health$) {
        proxy_connect_timeout 5s;
        proxy_pass http://${PLATFORM_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }
    # MLflow tracking UI under /mlflow/ (it loads assets and ajax-api relative to the page). MLflow only accepts its
    # allowed hosts, so the upstream address doubles as the Host header; the browser Origin is not forwarded.
    location = /mlflow { return 301 /mlflow/; }
    location ^~ /mlflow/ {
        proxy_connect_timeout 5s;
        proxy_pass http://${MLFLOW_UPSTREAM}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header Origin "";
        proxy_read_timeout 120s;
        client_max_body_size 10m;
    }
    location /assets/ { try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location ~ \.(json|js|css|png|svg)$ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
