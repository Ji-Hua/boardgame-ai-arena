# syntax=docker/dockerfile:1
# GPU training image for platform Jobs. It holds dependencies and the compiled rule engine only;
# each Job mounts its own read-only source snapshot at /job/source (see apps/jobs).
FROM python:3.12-slim AS engine-builder
RUN apt-get update && apt-get install -y --no-install-recommends cargo rustc gcc libc6-dev && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir maturin==1.9.6
COPY engine/Cargo.toml engine/Cargo.lock engine/pyproject.toml /build/engine/
COPY engine/src /build/engine/src
RUN cd /build/engine && maturin build --release --locked --out /wheels

FROM python:3.12-slim
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/Ji-Hua/boardgame-ai-arena" \
      org.opencontainers.image.revision=$SOURCE_COMMIT \
      org.quoridor.engine.revision=$SOURCE_COMMIT
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/job/source:/job/source/backend-server:/job/source/engine
WORKDIR /job/source
COPY deploy/requirements.runtime-cpu.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    pip install --no-cache-dir torch==2.11.0 --index-url https://download.pytorch.org/whl/cu126
COPY --from=engine-builder /wheels /tmp/wheels
RUN pip install --no-cache-dir /tmp/wheels/*.whl && rm -rf /tmp/wheels
RUN pip freeze > /python-dependencies.txt
CMD ["python", "-m", "agent_system.training.jobs", "/job/job.json"]
