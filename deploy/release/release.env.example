# Copy to release.env in a new ~/quoridor-releases/<name>/ together with this directory.
COMMIT=<short sha of a commit on the shared repository>
PLATFORM_IMAGE=<sha256:... of quoridor-agent-preview:platform-COMMIT, or empty>
GATEWAY_IMAGE=<sha256:... of quoridor-agent-preview-ui:platform-COMMIT, or empty>
MLFLOW_URI=http://127.0.0.1:8742
JOBS_ENV=JOBS_MODEL_INDEX=1
SYNC_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=10 jihua@192.168.68.102 systemctl --user start quoridor-mirror.service'
LAB_CATALOG=/home/jihua/quoridor-data/platform-p1-p2/catalogs/research-catalog-current.json
